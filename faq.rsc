1:[["$","section",null,{"className":"page-hero","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"QUICK ANSWERS"}],["$","h1",null,{"children":"The facts, with the gaps left visible."}],["$","p",null,{"children":"A useful guide should tell you what is verified—and what has not been verified yet. These answers stick to the public official experience data and description."}]]}],null]}],["$","section",null,{"className":"content faq-list","children":[[["$","details","Is Roblox Stock Exchange 2 about real investing?",{"open":true,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"01"}],"Is Roblox Stock Exchange 2 about real investing?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["No. The official game description says it is a simulation, uses in-game currency, and is not real money or financial advice. This independent guide is also not financial advice.",null]}]]}],["$","details","Which markets are confirmed in the game?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"02"}],"Which markets are confirmed in the game?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["The official description lists stocks, ETFs, futures, and IPOs. It also mentions leverage and shorting.",null]}]]}],["$","details","Does the game have order controls?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"03"}],"Does the game have order controls?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["Yes. Limit orders, stop losses, take profits, advanced indicators, and live order flow are in the official description. Read our Trading Orders guide for a cautious learning route.",[" ",["$","$L2",null,{"href":"/trading-orders","children":"Open the Trading Orders guide."}]]]}]]}],["$","details","Are algorithmic bots and offline portfolio growth available?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"04"}],"Are algorithmic bots and offline portfolio growth available?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["Both are named in the official description. We do not publish unverified availability conditions or earnings claims.",null]}]]}],["$","details","What does rebirth do?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"05"}],"What does rebirth do?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["Rebirth is a confirmed system and there is a First Rebirth badge. This site does not state its cost, reset behavior, or reward because those have not been verified.",[" ",["$","$L2",null,{"href":"/progression-rebirth","children":"Open the Progression guide."}]]]}]]}],["$","details","Are there codes?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"06"}],"Are there codes?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["We have not verified any active codes. This guide does not publish code lists until they can be confirmed from a reliable official source.",null]}]]}],["$","details","Is this the same game as RBLX Exchange?",{"open":false,"children":[["$","summary",null,{"children":[["$","span",null,{"children":"07"}],"Is this the same game as RBLX Exchange?",["$","b",null,{"aria-hidden":"true","children":"+"}]]}],["$","p",null,{"children":["No. This guide covers Roblox Stock Exchange 2, Universe ID 10495391267 and root place ID 110527353762049. Do not assume facts from similarly named experiences apply here.",null]}]]}]],["$","div",null,{"className":"source-note","children":[["$","span",null,{"className":"eyebrow","children":"EXPERIENCE IDENTITY"}],["$","p",null,{"children":[["$","b",null,{"children":"Creator:"}]," ","Summit Productions Development",["$","br",null,{}],["$","b",null,{"chi