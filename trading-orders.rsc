1:[["$","section",null,{"className":"page-hero","children":[["$","div",null,{"children":[["$","span",null,{"className":"eyebrow","children":"CONFIRMED ORDER TOOLS"}],["$","h1",null,{"children":"Know the control before you use it."}],["$","p",null,{"children":"Roblox Stock Exchange 2 lists limit orders, stop losses, take profits, live order flow, and advanced indicators. Here is a simple way to encounter them without inventing settings or outcomes."}]]}],["$","div",null,{"className":"page-hero-aside","children":["$","div",null,{"className":"hero-stat","children":[["$","b",null,{"children":"4 tools"}],["$","span",null,{"children":"Confirmed by the official description"}]]}]}]]}],["$","section",null,{"className":"content","children":[["$","div",null,{"className":"card-grid","children":[["$","article","Limit orders",{"className":"info-card","children":[["$","span",null,{"className":"number","children":["0",1]}],["$","h2",null,{"children":"Limit orders"}],["$","p",null,{"children":"A confirmed system for setting an order condition. Use the in-game interface to check the choices available to you; this guide does not assume any specific values or fills."}]]}],["$","article","Stop losses",{"className":"info-card","children":[["$","span",null,{"className":"number","children":["0",2]}],["$","h2",null,{"children":"Stop losses"}],["$","p",null,{"children":"A confirmed risk-control tool. Learn what it displays in your current position before you rely on it as an automatic answer."}]]}],["$","article","Take profits",{"className":"info-card","children":[["$","span",null,{"className":"number","children":["0",3]}],["$","h2",null,{"children":"Take profits"}],["$","p",null,{"children":"A confirmed exit-control tool. Pair it with a clear reason for the trade rather than treating it as a profit guarantee."}]]}],["$","article","Live order flow",{"className":"info-card","children":[["$","span",null,{"className":"number","children":["0",4]}],["$","h2",null,{"children":"Live order flow"}],[